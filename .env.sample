# Copy this file to .env and fill in the values.

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_DB=hostlib_db_v2
POSTGRES_USER=YOUR_DB_USER
POSTGRES_PASSWORD=YOUR_DB_PASSWORD
DB_HOST=localhost
DB_PORT=5434

# ── Connection pools ──────────────────────────────────────────────────────────
# Leave these unset unless Postgres runs out of connection slots. Every uvicorn
# worker and the scheduler is a separate process holding its own pools, so the
# worst case is roughly:
#   processes × (DB_POOL_SIZE + DB_MAX_OVERFLOW)
#   + DB_UPDATE_POOL_SIZE + DB_UPDATE_MAX_OVERFLOW
# With 4 workers + 1 scheduler the defaults give 5 × 7 + 30 = 65, which fits a
# stock Postgres (max_connections=100, less 3 reserved for superusers).
# Raise them where this database is ours alone; the compose files run Postgres
# with max_connections=200.
#DB_POOL_SIZE=5
#DB_MAX_OVERFLOW=2
#DB_UPDATE_POOL_SIZE=20
#DB_UPDATE_MAX_OVERFLOW=10
#
# Where several applications share one Postgres, the settings above only limit
# US. A neighbour that reconnects in a loop will still take every free slot and
# leave this application with "sorry, too many clients already" — that is what
# happened on 02.10.2026. The guard belongs on the server, one line per role,
# and it applies without restarting anything:
#   ALTER ROLE hlviewer   CONNECTION LIMIT 70;
#   ALTER ROLE <neighbour> CONNECTION LIMIT 40;
#   -- and raise the ceiling itself, which does need a restart:
#   ALTER SYSTEM SET max_connections = 300;
# Check who is actually connected with:
#   SELECT application_name, usename, state, count(*) FROM pg_stat_activity
#   GROUP BY 1,2,3 ORDER BY 4 DESC;
# This application signs its connections as hlviewer_api and hlviewer_update.

# ── Authentication ────────────────────────────────────────────────────────────
# Generate JWT_SECRET with: openssl rand -hex 32
JWT_SECRET=YOUR_JWT_SECRET
ADMIN_USERNAME=admin
ADMIN_PASSWORD=YOUR_ADMIN_PASSWORD
DEFAULT_USERNAME=viewer
DEFAULT_PASSWORD=YOUR_VIEWER_PASSWORD
# AUTO_LOGIN:
#  - LDAP disabled: true = automatic sign-in as DEFAULT_USERNAME without the login form
#  - LDAP enabled: automatic sign-in is OFF; true/false only controls how NEW domain
#    users are provisioned (see the LDAP block below)
AUTO_LOGIN=true

# ── LDAP (domain authentication) — optional ──────────────────────────────────
# LDAP_ENABLED=true lets users sign in with their DOMAIN credentials (verified
# by a direct bind as username@LDAP_DOMAIN; no service account, rights come
# from the app's user table). Unknown domain users are auto-provisioned:
#   AUTO_LOGIN=true  → created as an ACTIVE viewer (all branches), logs in at once
#   AUTO_LOGIN=false → created INACTIVE; an admin activates and assigns branches
# LDAP_DOMAIN is the UPN suffix (the part after @ in `whoami /upn`) — it may
# DIFFER from the DNS domain name. Find the DC with: nltest /dsgetdc:%USERDNSDOMAIN%
LDAP_ENABLED=false
LDAP_SERVER=ldaps://dc.example.local:636
LDAP_DOMAIN=example.local
LDAP_USE_SSL=true

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001,http://YOUR_SERVER_IP:3001

# ── Commercial day ────────────────────────────────────────────────────────────
# Gas commercial-day start hour (07:00 → 07:00). Served to the SPA via GET /config.
CONTRACT_HOUR=7

# ── Logging ───────────────────────────────────────────────────────────────────
# LOG_DIR is the path INSIDE the container. With the `.:/app` bind mount it maps
# to <repo>/logs on the host, so backend.log / backend.error.log / frontend.log
# are real files on the server (readable without Docker).
LOG_DIR=/app/logs
LOG_LEVEL=INFO
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# ── GSM polling ───────────────────────────────────────────────────────────────
# Both paths are relative to the app's working directory (/app in the
# container, i.e. <repo>/ on the host through the `.:/app` bind mount), and
# both have working defaults — set them only to move the files elsewhere.
# POLL_LOG_DIR: one journal file per site, rewritten by each poll session.
# AGENT_DIST_DIR: where the built agent (.exe) is kept for download from the
# admin panel; put a new build there with hl_poller/build_exe.py --install.
POLL_LOG_DIR=logs/poll
AGENT_DIST_DIR=backend/data/agent
