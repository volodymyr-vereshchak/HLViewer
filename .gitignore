# backend/data — only askcfgs is tracked; everything else fills up during operation
/backend/data/*
!/backend/data/askcfgs/
!/backend/data/askcfgs/**
# Shipped dictionary, not operational data: the accidents report reads it to
# turn DPD's event keys into wording we control.
!/backend/data/dpd_event_names.json

# Database dumps
/backend/data/server_dump.sql
/backend/data/server_dump.dump
/backend/data/*.backup
/backend/data/local_backup_*.sql
/backend/data/hostlib_backup

# Prediction output
/backend/data/*_output/
/backend/data/hourly_prediction_results.xlsx
*.parquet

# Pobut - not part of FastAPI server
/backend/pobut/

# Logs
*.log
/backend/*.log
/backend/*.txt
**/logs/
packages/
.claude/

# Build/dev artifacts that were committed by accident (now untracked)
*_results.txt
integration_test_output.log

# Test coverage output
.coverage
coverage.xml
htmlcov/

# Research outputs — research/ code is tracked, generated data is not
/research/*_output/
/research/*.xlsx
/research/*.csv
/research/*.png

# Preload JSON backups
backend/db/preload_db/*_old.json

# Local probe/debug scripts
/scripts/probe_hostlib/
